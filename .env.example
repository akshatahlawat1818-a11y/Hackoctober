# ==============================================================================
# Environment Configuration for Multi-Agent AI Workflow
# Copy this file to .env and fill in your credentials:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# ==============================================================================

# 1. Google Gemini API (for Planner, Writer, Tools, and Promo agents)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq API (for Critic agent running Llama models)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Google Cloud / Vertex AI (for Veo video generation)
# Project ID with Vertex AI API enabled and service account / ADC configured
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# ==============================================================================
# Model Configurations (Configurable via GEMINI_MODEL and GROQ_MODEL)
# ==============================================================================
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# Optional per-agent model overrides:
# MODEL_PLANNER=gemini-3.8-flash
# MODEL_RESEARCH=gemini-3.8-flash
# MODEL_WRITER=gemini-2.5-pro
# MODEL_CRITIC=openai/gpt-oss-120b
# MODEL_TOOLS=gemini-3.8-flash
# MODEL_PROMO=gemini-3.8-flash
# MODEL_VEO=veo-3.1-generate-001
# MODEL_VEO_DRAFT=veo-3.1-lite-generate-001
# MODEL_VEO_FINAL=veo-3.1-generate-001
# MAX_COST_USD=5.0

# ==============================================================================
# Optional Quality & Retry Thresholds
# ==============================================================================
# MAX_CRITIC_RETRIES=3
# CRITIC_PASS_SCORE=9.0
# CRITIC_MIN_CRITERION_SCORE=8.0
# TTS_VOICE=en-US-GuyNeural
